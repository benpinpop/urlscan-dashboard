# Copy to .env and edit. Never commit the real file.

# Bind address. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes it directly.
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Optional shared key. Leave unset so each analyst pastes their own key and
# spends their own urlscan quota.
# URLSCAN_API_KEY=

# Set true to ignore any key sent by the browser and always use URLSCAN_API_KEY.
FORCE_SERVER_KEY=false

URLSCAN_BASE_URL=https://urlscan.io/api/v1
REQUEST_TIMEOUT=30
# Maximum number of resolved domains held in the in-memory DNS cache.

# Backend abuse limits, counted per client address per worker.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=400

# Only enable behind a proxy that sets X-Forwarded-For itself.
TRUST_PROXY=false

# --- Result analyzer -------------------------------------------------------

# Where stored DOMs are fetched from (the site root, not the API).
URLSCAN_SITE_URL=https://urlscan.io

# Content analysis downloads and parses a whole page, so it gets its own
# budget on top of the limits above.

# Page content is attacker-controlled and unbounded. This is a memory guard.
MAX_DOM_BYTES=4194304

# Short server-side cache of fetched results, so reopening a scan and then
# analysing it does not spend two API calls. Set TTL to 0 to disable.
RESULT_CACHE_TTL=600
RESULT_CACHE_MAX_ENTRIES=64

# Override to keep your own keyword and domain tables outside the repo.
# KEYWORD_DB_PATH=/etc/urlscan-dashboard/keywords.csv
# DOMAIN_TABLE_PATH=/etc/urlscan-dashboard/domains.csv
