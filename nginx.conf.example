# /etc/nginx/sites-available/urlscan-dashboard
# Terminates TLS and forwards to gunicorn on loopback.
# Get a certificate first:  sudo certbot --nginx -d scans.example.com

server {
    listen 80;
    listen [::]:80;
    server_name scans.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name scans.example.com;

    ssl_certificate     /etc/letsencrypt/live/scans.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scans.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # API keys travel in a request header, so never log request headers here.
    access_log /var/log/nginx/urlscan-dashboard.access.log;

    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A 10,000-result search can take a while to come back.
        proxy_read_timeout 120s;
    }
}
